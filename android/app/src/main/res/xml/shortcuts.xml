<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the app icon for shortcuts to the alert settings and the last crash report. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:shortcutId="settings"
        android:shortcutLongLabel="@string/shortcut_settings_long"
        android:shortcutShortLabel="@string/shortcut_settings_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="org.theharmen.geenregenaub.alerts.SettingsActivity"
            android:targetPackage="org.theharmen.geenregenaub" />
    </shortcut>
    <shortcut
        android:enabled="true"
        android:icon="@drawable/ic_launcher_foreground"
        android:shortcutId="crash-report"
        android:shortcutLongLabel="@string/shortcut_crash_long"
        android:shortcutShortLabel="@string/shortcut_crash_short">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetClass="org.theharmen.geenregenaub.CrashReportActivity"
            android:targetPackage="org.theharmen.geenregenaub" />
    </shortcut>
</shortcuts>
