# Copy to .env (never commit .env) and fill in.

# Your registered KNMI Open Data API key, from https://developer.dataplatform.knmi.nl/register
KNMI_API_KEY=

# A long random string. The app sends it in the X-Geenregen-Key header.
# Generate one with:  openssl rand -hex 32
RELAY_SHARED_SECRET=

# Optional overrides; the defaults are right for milestone 1.
# KNMI_DATASET=radar_forecast
# KNMI_DATASET_VERSION=2.0
# KNMI_POLL_SECONDS=60
# OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
